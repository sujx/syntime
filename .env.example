# SynTime 容器栈配置模板。
#   cp .env.example .env      然后填下面三项
# .env 已被 .gitignore（`.env` / `.env.*`）与 .dockerignore 双重挡住：
# 既不入库，也不进镜像层。compose 只把它当作变量插值来源，容器环境由 compose.yaml 显式列举。

# ── 必填 ──────────────────────────────────────────────────────────────

# Django 签名密钥。生成：
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SYNTIME_SECRET_KEY=

# 数据库口令。compose 会同时把它交给 db 容器的 POSTGRES_PASSWORD，两边只用这一个值。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(24))"
SYNTIME_DB_PASSWORD=

# 云凭证 AK/SK 信封加密主密钥（KEK，base64 后的 32 字节）。
# 不设也能起栈，但一保存云账号就会 500（common/crypto.py:53），所以 init 服务会先拦下来。
# 生成：python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SYNTIME_MASTER_KEY=
# 不想让密钥进环境变量的话，改用文件形式（compose 的 secrets 风格），下面这行优先于上一行：
# SYNTIME_MASTER_KEY_FILE=/run/secrets/syntime_master_key

# ── 常用调整 ──────────────────────────────────────────────────────────

# 宿主发布端口。默认 8000；若本机已有服务占 8000（例如 backend/deploy_prod.sh 的宿主进程），
# 改成 8001 即可与之共存——db / redis 不发布宿主端口，不占用 5432 / 6379。
SYNTIME_WEB_PORT=8000

# gunicorn worker 数。默认 5，不要随手调小：PRD 4.1 闲置清单的达标读数 P95 1907ms
# 出自「5 并发 × 多进程」形状，单进程 5 线程实测 5851ms 不达标（见规格 §8.2）。
SYNTIME_WORKERS=5

# 逗号分隔。上线到域名或别的机器时把实际访问的 host 加进来，否则 Django 返回 400。
SYNTIME_ALLOWED_HOSTS=localhost,127.0.0.1

# ── 一般不用改 ────────────────────────────────────────────────────────

SYNTIME_DB_NAME=syntime_prod
SYNTIME_DB_USER=syntime

# 走反代 + HTTPS、且浏览器 Origin 与 Host 不一致时才需要填，形如 https://syntime.example.com
# SYNTIME_CSRF_TRUSTED_ORIGINS=

# 镜像 tag。同机想同时留多个版本时改这里。
SYNTIME_IMAGE_TAG=local

# 国内机器构建前端时换 npm 源，例：https://registry.npmmirror.com
# NPM_REGISTRY=
