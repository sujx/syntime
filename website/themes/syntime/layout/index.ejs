<% const C = site.data.copy; %>
<%# 本文件只负责首页的内容段；全局 chrome（ALPHA 横幅 + 固定导航、页脚）由 layout.ejs 装配，后续段按任务顺序追加在 Hero 之后 %>
<main>
<section class="hero">
  <div class="wrap">
    <div class="hero-copy io in">
      <h1 class="h1"><%= C.hero.title %></h1>
      <p class="sub"><%= C.hero.subtitle %></p>
      <div class="cta-row">
        <% C.hero.ctas.forEach(function(b){ %>
        <a class="btn btn-<%= b.style %> btn-xl" href="<%= b.href %>"><%= b.text %></a>
        <% }) %>
      </div>
      <ul class="feats">
        <% C.hero.feats.forEach(function(f){ %>
        <li><span class="ck" aria-hidden="true">✓</span><%= f %></li>
        <% }) %>
      </ul>
    </div>
    <figure class="hero-visual">
      <div class="browser">
        <div class="b-top"><span class="b-dot"></span><span class="b-dot"></span><span class="b-dot"></span>
          <span class="b-url">localhost:8000/dashboard</span></div>
        <img class="shot" src="<%- url_for('/images/gallery/dashboard.webp') %>"
             alt="<%= C.hero.screenshot_alt %>" loading="eager" width="2880" height="2556">
      </div>
      <figcaption class="shot-cap"><%= C.hero.caption %></figcaption>
    </figure>
  </div>
</section>

<%# 段 3 定位条：不抄原型的 `wrap pills-row io`（:447）——.pills-row 自带 flex 居中，嵌进 .wrap 不破版式；
    不带 io 是因为 main.js 仍是 T10 占位，.io{opacity:0} 无人解除，加了就是让这四条事实凭空消失。
    padding:48px 0 抄自原型 :446 的行内覆盖（.sec 默认 72px），间距 Token 表里没有 48px 一档，Token 化会改渲染。 %>
<section class="sec" style="padding:48px 0">
  <div class="wrap">
    <div class="pills-row">
      <% C.pills.forEach(function(p){ %><span class="pill info"><%= p %></span><% }) %>
    </div>
  </div>
</section>

<%# 段 4 已上线地基：版式完全复用 .feat-grid/.feat-card（设计方案 §2.1 段 4 明令不新立间距/字号），
    与功能段的区分只靠 sec-head 文案；class 名单与原型转录的 `sec sec-gray` 逐字未动。 %>
<section id="foundation" class="sec sec-gray">
  <div class="wrap">
    <div class="sec-head io">
      <h2 class="h2"><%= C.foundation.heading %></h2>
      <p class="lead"><%= C.foundation.subheading %></p>
    </div>
    <div class="feat-grid feat-grid-2">
      <% C.foundation.items.forEach(function(it){ %>
      <article class="feat-card io">
        <%- partial('partial/badge', {badge: it.badge, extra: 'badge'}) %>
        <h3><%= it.title %></h3>
        <p><%= it.body %></p>
      </article>
      <% }) %>
    </div>
  </div>
</section>

<%# 段 5 功能特性六卡：图标由 partial('partial/feat-icon') 按卡 id 取色底与图形（copy.yml 只装文案，
    §3 规则；色底逐字节取自原型 :464-489），徽章与 badge_note 一律从 cards[] 派生，模板不手写 pill、
    不写死档位。id 写在 class 前只为与本页其它段一致——判据一律走 sectionById，换序两种写法都认
    （全局约束 13）。 %>
<section id="features" class="sec sec-gray">
  <div class="wrap">
    <div class="sec-head io">
      <h2 class="h2"><%= C.features.heading %></h2>
      <p class="lead"><%= C.features.subheading %></p>
    </div>
    <div class="feat-grid">
      <% C.features.cards.forEach(function(c){ %>
      <article class="feat-card io">
        <%- partial('partial/badge', {badge: c.badge, extra: 'badge'}) %>
        <%- partial('partial/feat-icon', {id: c.id}) %>
        <h3><%= c.title %></h3>
        <p><%= c.body %></p>
        <% if (c.badge_note) { %><p class="badge-note"><%= c.badge_note %></p><% } %>
      </article>
      <% }) %>
    </div>
  </div>
</section>

<%# 段 6 界面速览：截图是真文件（source/images/gallery/*.webp，capture_shots.mjs 以 deviceScaleFactor 2
    截取），路径 / 标题 / alt / disclaimer 全部来自 copy.gallery，模板不新增一句中文。
    图注文字内联在 HTML 里，不抄原型 :829-834 的 CAPS 对象（那份写「厂商消息与平台自算双通道」，与 Q20 冲突，
    且违反「无 copy.yml 之外的硬编码中文」）。
    DIMS 是表现层的固有尺寸（防 CLS），键为 copy.yml 的图片路径：换图必须同步改这里，
    否则判据按文件字节现量即红（honesty.test.mjs 的 T7 三条）。图片在此只出现一次（<img> 模板化），
    按钮与面板两轮迭代都派生自 segments[]，data-shot 用序号——copy.gallery.segments 没有 id 键，
    序号就是 T10 认的配对键。
    io 不带 in：`.io.in{opacity:1}`（main.css:213）是 T10 运行时的解锁态，预置 in 等于取消淡入。
    T10 必验：面板先解除 hidden 才谈得上 .shot-frame/.shot-cap 的 in（hidden 期间不参与布局、IO 不命中），须实测一次真实点击后无注入的可见性。
    非当前按钮不写 class=""、非当前面板把 hidden 拼在属性串尾部：原型 :505-508 的 inactive 按钮
    本来就没有 class 属性，产物也不留空属性与 `data-shot="0" >` 这种尾随空格。 %>
<section id="gallery" class="sec">
  <div class="wrap">
    <div class="sec-head io">
      <h2 class="h2"><%= C.gallery.heading %></h2>
      <p class="lead"><%= C.gallery.subheading %></p>
    </div>
    <p class="disclaimer"><%= C.gallery.disclaimer %></p>
    <div class="seg-row io">
      <div class="seg" id="seg-shot" role="tablist" aria-label="<%= C.gallery.heading %>">
        <% C.gallery.segments.forEach(function(g, i){ %>
        <button type="button" role="tab" data-shot="<%= i %>" aria-selected="<%= i === 0 %>"<% if (i === 0) { %> class="on"<% } %>><%= g.title %></button>
        <% }) %>
      </div>
    </div>
    <% const DIMS = { '/images/gallery/settlement.webp': [2880, 2674],
                      '/images/gallery/dashboard.webp': [2880, 2556],
                      '/images/gallery/events.webp': [2880, 1800],
                      '/images/gallery/governance.webp': [2880, 1800] }; %>
    <% C.gallery.segments.forEach(function(g, i){ %>
    <div class="shot-panel" data-shot="<%= i %>"<% if (i !== 0) { %> hidden<% } %>>
      <div class="shot-frame io">
        <img src="<%= url_for(g.image) %>" alt="<%= g.alt %>" loading="lazy"
             width="<%= DIMS[g.image][0] %>" height="<%= DIMS[g.image][1] %>">
      </div>
      <p class="shot-cap io"><%= g.title %> · <%= C.gallery.disclaimer %></p>
    </div>
    <% }) %>
  </div>
</section>
</main>
