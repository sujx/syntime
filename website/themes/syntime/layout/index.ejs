<% const C = site.data.copy; %>
<%# 本文件只负责首页的内容段；全局 chrome（ALPHA 横幅 + 固定导航、页脚）由 layout.ejs 装配，后续段按任务顺序追加在 Hero 之后 %>
<main>
<section class="hero">
  <div class="wrap">
    <div class="hero-copy io in">
      <h1 class="h1"><%= C.hero.title %></h1>
      <p class="sub"><%= C.hero.subtitle %></p>
      <div class="cta-row">
        <% C.hero.ctas.forEach(function(b){ %>
        <a class="btn btn-<%= b.style %> btn-xl" href="<%= b.href %>"><%= b.text %></a>
        <% }) %>
      </div>
      <ul class="feats">
        <% C.hero.feats.forEach(function(f){ %>
        <li><span class="ck" aria-hidden="true">✓</span><%= f %></li>
        <% }) %>
      </ul>
    </div>
    <figure class="hero-visual">
      <div class="browser">
        <div class="b-top"><span class="b-dot"></span><span class="b-dot"></span><span class="b-dot"></span>
          <span class="b-url">localhost:8000/dashboard</span></div>
        <img class="shot" src="<%- url_for('/images/gallery/dashboard.webp') %>"
             alt="<%= C.hero.screenshot_alt %>" loading="eager" width="2880" height="2556">
      </div>
      <figcaption class="shot-cap"><%= C.hero.caption %></figcaption>
    </figure>
  </div>
</section>

<%# 段 3 定位条：不抄原型的 `wrap pills-row io`（:447）——.pills-row 自带 flex 居中，嵌进 .wrap 不破版式；
    不带 io 是因为 main.js 仍是 T10 占位，.io{opacity:0} 无人解除，加了就是让这四条事实凭空消失。
    padding:48px 0 抄自原型 :446 的行内覆盖（.sec 默认 72px），间距 Token 表里没有 48px 一档，Token 化会改渲染。 %>
<section class="sec" style="padding:48px 0">
  <div class="wrap">
    <div class="pills-row">
      <% C.pills.forEach(function(p){ %><span class="pill info"><%= p %></span><% }) %>
    </div>
  </div>
</section>

<%# 段 4 已上线地基：版式完全复用 .feat-grid/.feat-card（设计方案 §2.1 段 4 明令不新立间距/字号），
    与功能段的区分只靠 sec-head 文案；id 写在 class 前是因为 honesty.test.mjs 的 S6-1 判据按
    `<section id="foundation"` 字面切片，class 名单与原型转录的 `sec sec-gray` 逐字未动。 %>
<section id="foundation" class="sec sec-gray">
  <div class="wrap">
    <div class="sec-head io">
      <h2 class="h2"><%= C.foundation.heading %></h2>
      <p class="lead"><%= C.foundation.subheading %></p>
    </div>
    <div class="feat-grid feat-grid-2">
      <% C.foundation.items.forEach(function(it){ %>
      <article class="feat-card io">
        <%- partial('partial/badge', {badge: it.badge, extra: 'badge'}) %>
        <h3><%= it.title %></h3>
        <p><%= it.body %></p>
      </article>
      <% }) %>
    </div>
  </div>
</section>
</main>
