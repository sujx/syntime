<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% const C = site.data.copy; %>
<% const isHome = !page.title || page.layout === 'index'; %>
<% const canonUrl = String(page.permalink || '').replace(/\/index\.html$/, '/'); %>
<title><%= isHome ? C.meta.title : page.title + ' · ' + config.title %></title>
<meta name="description" content="<%= isHome ? C.meta.description : (page.excerpt || C.meta.description) %>">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 96 96'%3E%3Crect width='96' height='96' rx='22' fill='%23C0392B'/%3E%3Ctext x='48' y='66' font-size='56' font-weight='700' fill='%23fff' text-anchor='middle' font-family='KaiTi,STKaiti,serif'%3E%E5%81%95%3C/text%3E%3C/svg%3E">
<link rel="canonical" href="<%= canonUrl %>">
<link rel="stylesheet" href="<%= url_for('/css/main.css') %>">
<meta property="og:type" content="<%= isHome ? 'website' : 'article' %>">
<meta property="og:title" content="<%= isHome ? C.meta.title : page.title %>">
<meta property="og:description" content="<%= C.meta.description %>">
<meta property="og:image" content="<%= config.url %><%= url_for(C.meta.og_image) %>">
<meta property="og:url" content="<%= canonUrl %>">
<meta property="og:locale" content="zh_CN">
<meta property="og:site_name" content="<%= config.title %>">
<meta name="twitter:card" content="summary_large_image">
<%# 无 JS 兜底（终审 I2）：main.css 的 .io{opacity:0} 只由脚本进场揭走，禁 JS 时整页永久隐形；这条覆写排在样式表之后（同特异度、后来者胜）且只在无脚本时生效 %><noscript><style>.io{opacity:1;transform:none}</style></noscript>
</head>
