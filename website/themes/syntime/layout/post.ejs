<% const C = site.data.copy; %>
<%# 文章页布局。<main> 的 id 与 layout.ejs 里 skip link 的 href 是同一份契约（T11 定），
    两页共用同一个 id，故这里只写 id 不写 skip；正文不挂 .io（禁用 JS 时不得消失）。
    返回链接的文案取自 labels：内容层是中文文案的单一来源，模板只出结构与图标。 %>
<main id="main">
<section class="sec">
  <div class="wrap wrap-narrow">
    <article class="post">
      <h1><%= page.title %></h1>
      <time class="post-date" datetime="<%= page.date.format('YYYY-MM-DD') %>"><%= page.date.format('YYYY-MM-DD') %></time>
      <div class="post-body"><%- page.content %></div>
      <p class="post-back"><a href="<%= url_for('/updates/') %>"><%= C.labels.post_back %></a></p>
    </article>
  </div>
</section>
</main>
